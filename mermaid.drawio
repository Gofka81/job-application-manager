  <diagram name="Page-1" id="Ulg-MmWFcOT4Jgxjw74X">
    <mxGraphModel dx="1410" dy="838" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\nsubgraph S1 [1 -- JOB-RADAR -- Raspberry Pi + Docker + Cloudflare Tunnel -- WF1]\n  SRC[(10 джерел -- офіційні API&lt;br&gt;вакансія + posted_at freshness)]\n  SCAN[нормалізація, dedup,&lt;br&gt;фільтри за freshness і критеріями]\n  TRIAGE[bounded LLM triage&lt;br&gt;fit 0-10 + причина]\n  RDB[(SQL job-radar&lt;br&gt;jobs, seen, scores)]\n  INBOX[(INBOX&lt;br&gt;title, company, JD, score)]\n  WDOG[сторож -- дата останньої подачі&lt;br&gt;мовчання довше N днів]\n  TGN[Telegram&lt;br&gt;тільки вихід, не пульт]\nend\n\nsubgraph S2 [2 -- HUB / КОНВЕЄР ЗАЯВКИ -- MacBook, Python]\n  INTAKE[intake -- нормалізація лінка&lt;br&gt;JD, score, дедуп по поданих]\n  GEN[WF2 рендер CV і cover&lt;br&gt;профіль версії + підгонка під JD]\n  GATE[WF2 fact gate&lt;br&gt;детермінований, без моделі]\n  GCV{{людина -- апрув CV}}\n  COPILOT[WF3 агент заповнює форму&lt;br&gt;у браузері]\n  STOP{{WF3 STOP -- список полів,&lt;br&gt;підсвічені виведені агентом}}\n  HUMAN{{людина -- OTP, CAPTCHA, клік}}\n  TRACK[WF4 tracker&lt;br&gt;статус = згортка status.jsonl]\n  RWATCH[WF4 reply-watch&lt;br&gt;Gmail, закритий список заявок]\n  GST{{людина -- апдейт статусу}}\n  PREP[WF5 prep sheet&lt;br&gt;одна сторінка, на вимогу]\n  ROUND[WF5 інтерв ю-раунд]\n  DEBR[WF5 дебріф -- 3 питання&lt;br&gt;+ прогноз, того ж дня]\n  AGING[WF6 aging -- stale довше N днів&lt;br&gt;ліміт 2 дотики на компанію]\n  GFU{{людина -- надсилає&lt;br&gt;follow-up вручну}}\nend\n\nsubgraph S3 [3 -- HUB / КЛЮЧОВІ АКТИВИ -- живуть довше за одну вакансію]\n  MASTER[(master-profile.yaml&lt;br&gt;+ versions -- профілі рендеру)]\n  MAT[(materials -- CV, cover&lt;br&gt;у каталозі заявки)]\n  ANSW[(банк відповідей&lt;br&gt;answer-bank.yaml)]\n  STORY[(story bank + банк питань&lt;br&gt;+ слабкі місця)]\n  TPL[(темплейти + contacts.tsv)]\n  DEC[(decision journal)]\nend\n\nsubgraph S4 [4 -- HUB / ФАКТИ -- append-only, ніколи не переписуються]\n  APP[(application.json&lt;br&gt;канал, discovery, cv_version)]\n  SLOG[(status.jsonl)]\n  RLOG[(rounds.jsonl)]\n  FLOG[(follow-up.jsonl)]\n  CHLOG[(changes.jsonl)]\nend\n\nsubgraph S5 [5 -- HUB / АНАЛІТИКА -- WF7]\n  ANL[детектор катастроф на DuckDB&lt;br&gt;читає файли напряму, без ingest&lt;br&gt;вердикт -- ок, катастрофа, даних мало]\nend\n\nMANUAL{{людина -- довільний лінк&lt;br&gt;LinkedIn, сайт компанії}}\n\n%% WF1\nSRC --&gt;|сирі вакансії з API| SCAN\nSCAN --&gt;|унікальні свіжі кандидати| TRIAGE\nSCAN --&gt;|dedup-ключі, seen| RDB\nRDB --&gt;|вже бачені| SCAN\nTRIAGE --&gt;|score 0-10| RDB\nRDB --&gt;|top-N за score| INBOX\nWDOG -.-&gt;|подач не було N днів| TGN\n\n%% два входи в хаб\nINBOX ==&gt;|обрана вакансія з радару, лінк + JD| INTAKE\nMANUAL ==&gt;|агент читає JD зі сторінки| INTAKE\nINTAKE --&gt;|однакове досьє незалежно від гілки| GEN\n\n%% WF2\nMASTER --&gt;|факти + профіль версії| GEN\nGEN --&gt;|відрендерений CV| GATE\nGATE --&gt;|претензії звірені з майстром| GCV\nGCV --&gt;|схвалено| MAT\n\n%% WF3\nMAT --&gt;|CV + cover.pdf| COPILOT\nANSW --&gt;|відомі відповіді на поля| COPILOT\nCOPILOT --&gt;|форма заповнена&lt;br&gt;+ пачка питань без відповіді| STOP\nSTOP --&gt;|передача керування| HUMAN\nHUMAN ==&gt;|нове питання + відповідь + alias| ANSW\nHUMAN --&gt;|Submit підтверджено -- межа WF3/WF4| APP\nAPP -.-&gt;|пінг -- тільки дата, fire-and-forget| WDOG\n\n%% WF4\nAPP --&gt;|нова заявка| TRACK\nTRACK --&gt;|подія переходу| SLOG\nRWATCH --&gt;|розпізнаний статус або unclear| GST\nGST --&gt;|підтверджений from-to| SLOG\nSLOG --&gt;|згортка журналу = поточний стан| TRACK\n\n%% WF5\nTRACK --&gt;|статус = in_process| PREP\nSTORY --&gt;|5 історій під JD і тип раунду| PREP\nPREP --&gt;|одна сторінка| ROUND\nROUND --&gt;|факт раунду| RLOG\nROUND --&gt;|нотатки того ж дня| DEBR\nDEBR ==&gt;|тижнева курація -- історії,&lt;br&gt;питання, слабкі місця| STORY\n\n%% WF6\nTRACK --&gt;|мовчання довше stale_days| AGING\nAGING --&gt;|черга follow-up| GFU\nTPL --&gt;|шаблон + контакт| GFU\nGFU --&gt;|лист надіслано| FLOG\nFLOG --&gt;|факт дотику| SLOG\n\n%% WF7 -- DuckDB читає файли, ingest немає\nAPP -.-&gt;|канал, discovery, cv_version| ANL\nMAT -.-&gt;|метадані CV-версій| ANL\nSLOG -.-&gt;|переходи статусів| ANL\nRLOG -.-&gt;|етапи інтерв ю| ANL\nFLOG -.-&gt;|дотики| ANL\nCHLOG -.-&gt;|дати змін для зрізу до-після| ANL\nANL --&gt;|вердикт -- канал X мертвий,&lt;br&gt;стіна на вході| DEC\nANL -.-&gt;|керує фокусом підготовки| PREP\n\n%% петлі зворотного звязку\nDEC ==&gt;|нова CV-версія, зміна позиціонування| MASTER\nDEC ==&gt;|рішення переписати LinkedIn -- руками| CHLOG\nSTORY ==&gt;|повторювані провали| DEC\n\nclassDef pi fill:#dbeafe,stroke:#1d4ed8,color:#0f172a\nclassDef hub fill:#dcfce7,stroke:#15803d,color:#0f172a\nclassDef human fill:#ffedd5,stroke:#c2410c,stroke-width:2px,color:#0f172a\nclassDef asset fill:#fef9c3,stroke:#a16207,stroke-width:3px,color:#0f172a\nclassDef log fill:#e5e7eb,stroke:#4b5563,color:#0f172a\n\nclass SRC,SCAN,TRIAGE,RDB,INBOX,WDOG,TGN pi\nclass INTAKE,GEN,GATE,COPILOT,TRACK,RWATCH,PREP,ROUND,DEBR,AGING,ANL hub\nclass GCV,STOP,HUMAN,GST,GFU,MANUAL human\nclass MASTER,MAT,ANSW,STORY,TPL,DEC asset\nclass APP,SLOG,RLOG,FLOG,CHLOG log&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PDxMsj-ZOB8IkHQ2VrI0-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
