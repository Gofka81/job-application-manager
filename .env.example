# Copy to .env and fill in. .env is gitignored and never committed.

# --- job-radar (D24) ---
# The INBOX side: `jam inbox` reads GET /api/jobs with this bearer token.
JOB_RADAR_API_URL=https://job-radar.example.com
JOB_RADAR_API_TOKEN=

# --- watchdog on the Pi (D62) ---
# job-radar endpoint, protected by a Cloudflare Access policy
WATCHDOG_URL=https://radar.example.com/hub/ping
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Gmail, read-only (D58) ---
GMAIL_CREDENTIALS_PATH=~/.config/job-hub/gmail-credentials.json
GMAIL_TOKEN_PATH=~/.config/job-hub/gmail-token.json

# --- paths ---
JAM_DATA_DIR=./data
